# Terminal-Ui Environment Variables Template
# Copy this file to `.env` and fill in your actual credentials.
# DO NOT commit your `.env` file to version control.

# ----------------------------------------
# 1. GitHub Integration
# ----------------------------------------
# Generate a Personal Access Token (Classic) at: https://github.com/settings/tokens
# Scopes needed: read:user, repo
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ----------------------------------------
# 2. LeetCode Integration
# ----------------------------------------
# Your public LeetCode username
LEETCODE_USERNAME=your_leetcode_username

# Optional: Session cookie if accessing private submissions/stats (leave empty for public stats)
# LEETCODE_SESSION=your_leetcode_session_cookie

# ----------------------------------------
# 3. Spotify Integration (Optional for Web API)
# ----------------------------------------
# Note: On macOS, the app uses native AppleScript by default (zero setup required).
# Only fill these if you explicitly choose the Spotify Web API.
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
